# --- Python関連 ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
env/
venv/

# --- テスト・キャッシュ ---
.pytest_cache/
test_results/
*.test.log

# --- 学習データ・ログ（重いので除外） ---
# 学習ログ (Tensorboardなど)
/logs/*
!/logs/.gitkeep

# 評価結果ファイル（実行のたびに生成されるため除外）
logs/benchmark_*.csv
logs/benchmark_*.json

# --- 学習済みモデルファイル ---
# モデルファイルは重いのでGitには含めない
# 共有する場合はGit LFSを使用するか、手動で管理
models/*.zip
models/checkpoints/
*.pth
*.pkl

# --- スクリプトが生成する出力画像・動画 ---
# 生成される全画像・動画ファイル
*.png
*.gif
*.mp4
*.avi
# gif/ 以下の全ファイル
gif/

# --- エディタ・OS関連 ---
.vscode/
.DS_Store
Thumbs.db

# --- Docker関連 ---
# .devcontainer/ は共有する場合は除外しない
