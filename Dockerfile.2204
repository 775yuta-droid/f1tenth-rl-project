# 1. ベースイメージ (Ubuntu 22.04 LTS / CUDA 12.4)
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

# 2. 環境設定
ENV DEBIAN_FRONTEND=noninteractive

# 3. システムパッケージのインストール
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    cmake \
    build-essential \
    swig \
    wget \
    && rm -rf /var/lib/apt/lists/*

# 4. pipのアップグレード
RUN pip3 install --no-cache-dir --upgrade pip

# 5. 対応 PyTorch (Nightly版を使用して Blackwell / sm_120 に対応)
# Nightly のインデックス不整合を避けるため、torch 本体を優先し、torchvision は依存関係を無視して入れます
RUN pip3 install --no-cache-dir --pre torch --index-url https://download.pytorch.org/whl/nightly/cu124 && \
    pip3 install --no-cache-dir torchvision --no-deps

# 6. RL関連 & 依存ライブラリの導入
# f1tenth_gym と stable-baselines3 の互換性のために numpy と numba を固定
RUN pip3 install --no-cache-dir \
    "numpy<1.24" \
    "numba>=0.55.2" \
    "pyglet<1.5" \
    pyopengl \
    pyyaml \
    stable-baselines3[extra] \
    shimmy>=0.2.1 \
    gymnasium \
    imageio \
    imageio-ffmpeg \
    matplotlib \
    scipy \
    onnx \
    onnxruntime \
    "protobuf<4"

# 7. f1tenth_gym のインストール
RUN git clone https://github.com/f1tenth/f1tenth_gym.git /opt/f1tenth_gym

# 自作マップをビルド時に反映
COPY ./my_maps/my_map.pgm /opt/f1tenth_gym/gym/f110_gym/envs/maps/
COPY ./my_maps/my_map.yaml /opt/f1tenth_gym/gym/f110_gym/envs/maps/
WORKDIR /opt/f1tenth_gym

# 手動で成功した「Gym 0.23.1」の強制インストール手順
RUN pip3 install --no-cache-dir "setuptools<66" && \
    pip3 install --no-cache-dir "gym==0.23.1" && \
    pip3 install --no-cache-dir -e . --no-deps

# 8. マップファイルの準備 (シミュレータの内部仕様に合わせる)
RUN cp /opt/f1tenth_gym/gym/f110_gym/envs/maps/levine.pgm /opt/f1tenth_gym/gym/f110_gym/envs/maps/levine.png

# 9. 作業ディレクトリの設定
WORKDIR /workspace